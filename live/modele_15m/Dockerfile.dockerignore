# BuildKit per-Dockerfile ignore. Build context = this folder (live/modele_15m/).
# Keeps the image lean and never bakes secrets in.

# Python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Runtime logs (mounted as a host volume, not baked in)
logs/

# Stray data files (none expected in this folder, defensive)
*.csv
*.parquet
*.db
*.sqlite

# Docker + tooling
Dockerfile
Dockerfile.dockerignore
docker-compose.yml
.git/
.venv/
.idea/
.vscode/

# Secrets - compose injects .env at runtime via env_file; never bake it in.
.env
.env.*
!.env.example
