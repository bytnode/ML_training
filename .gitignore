# ============================================================
#  Datasets, logs, databases (regenerable or big)
# ============================================================
*.parquet
*.db
*.sqlite
*.sqlite3
*.log

# Backup files of any of the above (foo.parquet.bak, foo.parquet.bak2,
# foo.parquet.bak_clean, etc). The *.parquet rule above only matches paths
# ENDING in .parquet, so .parquet.bak* leaks through without this.
*.bak
*.bak[0-9]*
*.bak_*

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# ============================================================
#  Editors / OS
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db

# ============================================================
#  Secrets / credentials (.env at any depth)
# ============================================================
.env
.env.*
!.env.example

# ============================================================
#  Stray / typo files
# ============================================================
backtest/modele_updown/python
