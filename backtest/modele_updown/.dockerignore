# Keep the Docker build context small. Without this, the modele_*/DB and
# logs/ folders push the context to ~500 MB.

# Python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local logs (mounted as a volume at runtime, not baked in)
logs/
15min/modele_up/logs/
15min/modele_down/logs/

# Training data + DB (NOT needed at inference time)
15min/modele_up/DB/
15min/modele_down/DB/
15min/modele_down/db/

# Training-only helper scripts (not used by live.py)
15min/modele_up/analyse/
15min/modele_down/analyse/

# Training pipeline modules (live.py only needs config + data + model artifacts)
15min/modele_up/features.py
15min/modele_up/predict.py
15min/modele_up/train.py
15min/modele_up/api.py
15min/modele_down/features.py
15min/modele_down/predict.py
15min/modele_down/train.py
15min/modele_down/api.py

# Backtest / team script (not part of live)
main.py

# Raw CSV / parquet / sqlite anywhere in tree
*.csv
*.parquet
*.db

# Docs / notes
*.md
docs/

# Tooling / VCS
.git/
.gitignore
.venv/
.idea/
.vscode/

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Secrets - never bake into image (compose reads .env at runtime via env_file)
.env
.env.*
!.env.example
