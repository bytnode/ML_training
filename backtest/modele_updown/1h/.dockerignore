# Lu lors du build de live/Dockerfile (build context = 1h/, cf.
# modele_team/live/docker-compose.yml -- necessaire car live/ importe modele_up/,
# modele_down/, regime/, TOUS siblings de modele_team/, donc hors de portee d'un
# contexte modele_team/ seul). Garde l'image legere : uniquement le code + les
# artifacts modele (.json) necessaires a l'inference, pas les datasets bruts.

__pycache__/
*.pyc
*.pyo
*.pyd
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Datasets / DB regenerables (gros, jamais necessaires au runtime live -- les
# features live viennent de Bitstamp via calcule_feature.py, pas du parquet).
*.parquet
*.db
*.sqlite
*.csv
DB/
DB_1m/
DB_5m/
DB_15m/
eth_data/

# Logs (backtest ET live -- live/logs/ est monte en volume au runtime).
logs/

# Scripts d'exploration, jamais executes en prod.
optimize/
analyse/

# Secrets : charges via env_file de compose, jamais copies dans l'image.
.env
.env.*
