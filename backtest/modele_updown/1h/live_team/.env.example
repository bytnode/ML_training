# === MEXC futures (clés API avec permission "Futures / Order Placing" + KYC) ===
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=

# Base REST : FUTURES = contract.mexc.com (api.mexc.com = SPOT).
# ⚠️ VÉRIFIE par un appel public avant le réel ; surcharge ici si la migration api.mexc.com est effective.
MEXC_REST_HOST=https://contract.mexc.com
MEXC_WS_URL=wss://contract.mexc.com/edge

# === Sizing / risque ===
BET_FRACTION=0.5          # part du solde futures engagée en marge par position (0.5 = backtest)
MIN_VOL=1                 # contrats minimum (mets 1 pour la validation micro-volume, puis monte)
DRY_RUN=false             # true = signe/prépare les ordres mais NE POSTE PAS (test connexion/signature)

# === Telegram (optionnel : laisser vide = notifications no-op) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot d'erreur séparé (reçoit tout logger.error/exception)
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
