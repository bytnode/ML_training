# live/.env.example -- MODELE a copier en live/.env (gitignore). Ne mets JAMAIS
# de vraie cle ici. Regenere les cles OKX si elles ont fuite (audit 2026-08-03,
# point #12) et scope la cle "Trade" uniquement + IP-whitelist.

# SECURITE : true = cycle complet mais AUCUN appel d'ecriture OKX. Passe a false
# UNIQUEMENT quand tu es pret a trader en argent reel (et supprime d'abord
# live/logs/positions_state.json, cf point #2).
DRY_RUN=true

# --- OKX (SWAP perpetuel BTC-USDT-SWAP, mode HEDGE, marge ISOLATED) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX_INST_ID=BTC-USDT-SWAP

# --- Parametres financiers (vide = retombe sur config_main.py, symetrie backtest) ---
OKX_LEVERAGE=
OKX_POSITION_FRACTION=

# --- Filet catastrophe natif OKX (audit 2026-08-03, point #1) ---
# Stop STATIQUE pose cote OKX, s'execute meme si le daemon est mort. Vide = defauts
# config_live.py (UP -3.0% / DOWN -2.5% ; bien avant la liquidation ~ -9% a 10x).
# NATIVE_BACKSTOP_ENABLED=1
# CATASTROPHE_SL_UP_PCT=0.030
# CATASTROPHE_SL_DOWN_PCT=0.025

# --- Robustesse (vide = defauts config_live.py) ---
# DESYNC_CONFIRM_TICKS=3      # lectures "absente" consecutives avant desync (point #4)
# SIZING_SAFETY_BUFFER=0.98   # coussin marge dispo (point #6)
# MAX_CLOCK_SKEW_S=20         # alerte derive horloge vs OKX (point #11)

# --- Telegram (bot operationnel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram (bot d'erreur, optionnel) ---
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
