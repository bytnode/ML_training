# Lu lors du build Docker (build context = racine du repo, cf. infra/docker-compose.yml).
# Garde l'image leger : on n'embarque que le code (backtest/ + live/) et les deps Python.

__pycache__/
*.pyc
*.pyo
*.pyd

.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docs / specs : pas besoin dans le runtime.
docs/

# Datasets / artifacts du pipeline backtest (regenerables, gros).
*.csv
backtest/modele_15m/training_data*.csv
backtest/modele_15m/logs/

# Modele + sidecar : montes en volume au runtime, pas bakes dans l'image.
backtest/modele_15m/btc_reversal_model.json
backtest/modele_15m/btc_reversal_model.thresholds.json

# Secrets : charges via env_file de compose, pas copies dans l'image.
.env

# Logs live : montes en volume.
live/logs/

# Pyproject / venv eventuels.
.venv/
venv/
env/
